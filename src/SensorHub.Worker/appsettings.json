{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5433;Database=sensorhub;Username=sensorhub;Password=sensorhub;Maximum Pool Size=20"
  },
  "Redis": {
    "ConnectionString": "localhost:6380,abortConnect=false"
  },
  "Worker": {
    "Consumers": [ "persistence", "lastvalue" ]
  },
  "Kafka": {
    "BootstrapServers": "localhost:29092"
  },
  "Persistence": {
    "Strategy": "Unnest"
  },
  "Consumers": {
    "Persistence": {
      "GroupId": "sensorhub.persistence",
      "MaxBatchSize": 5000,
      "MaxWaitMs": 250
    }
  }
}
