{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5433;Database=sensorhub;Username=sensorhub;Password=sensorhub;Maximum Pool Size=20"
  },
  "Redis": {
    "ConnectionString": "localhost:6380,abortConnect=false"
  },
  "Kafka": {
    "BootstrapServers": "localhost:29092"
  },
  "Realtime": {
    "Enabled": true,
    "FlushMs": 250
  },
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  },
  "Observability": {
    "OtlpEndpoint": "",
    "TraceSampleRatio": 1.0
  },
  "Ingestion": {
    "MaxBatchSize": 1000
  }
}
