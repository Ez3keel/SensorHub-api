{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5433;Database=sensorhub;Username=sensorhub;Password=sensorhub;Maximum Pool Size=20"
  },
  "Redis": {
    "ConnectionString": "localhost:6380,abortConnect=false"
  },
  "Kafka": {
    "BootstrapServers": "localhost:29092"
  },
  "Realtime": {
    "Enabled": true,
    "FlushMs": 250
  },
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  },
  "Security": {
    "Enabled": true,
    "JwtSigningKey": "",
    "JwtIssuer": "sensorhub",
    "JwtAudience": "sensorhub-clients",
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "7.00:00:00",
    "DeviceCacheSeconds": 30,
    "SensorCacheSeconds": 30,
    "BootstrapAdmin": { "Email": "", "Password": "" },
    "RateLimits": {
      "IngestionPerSecond": 50,
      "IngestionBurst": 200,
      "AuthPerMinute": 10,
      "ApiPerMinute": 600
    }
  },
  "Observability": {
    "OtlpEndpoint": "",
    "TraceSampleRatio": 1.0
  },
  "Ingestion": {
    "MaxBatchSize": 1000
  }
}
