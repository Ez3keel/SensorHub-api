      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, group)(rate(sensorhub_consumer_processing_delay_seconds_bucket[1m])))",
          "legendFormat": "p50 {{group}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, group)(rate(sensorhub_consumer_processing_delay_seconds_bucket[1m])))",
          "legendFormat": "p95 {{group}}",
          "datasource": {
