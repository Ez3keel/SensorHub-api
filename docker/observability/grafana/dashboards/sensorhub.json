          "legendFormat": "retry {{group}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (group, reason)(rate(sensorhub_consumer_dead_letters_total[1m]))",
          "legendFormat": "dlq {{group}} {{reason}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
