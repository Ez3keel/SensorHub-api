    {
      "id": 13,
      "type": "timeseries",
      "title": "Retentativas (falha transitória) e DLQ /s",
      "description": "Retry > 0 = banco/Redis/Kafka instável. DLQ > 0 = mensagens inválidas sendo desviadas: investigar.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 27,
        "w": 8,
        "h": 8
