# Copie para .env (ignorado pelo git) e ajuste. NUNCA commite segredos reais.
# Chave de assinatura do JWT: >= 32 bytes aleatórios. Gere com:  openssl rand -base64 48
SENSORHUB_JWT_KEY=
SENSORHUB_ADMIN_EMAIL=admin@sensorhub.local
SENSORHUB_ADMIN_PASSWORD=
# Chave do dispositivo gateway (impressa UMA vez por: docker compose --profile tools run --rm register)
SENSORHUB_DEVICE_KEY=
# Parâmetros da carga (opcionais)
SENSORS=300
RATE=3000
DURATION=60

# Segredo do bridge MQTT no broker (>= 16 caracteres)
SENSORHUB_MQTT_BRIDGE_PASSWORD=
